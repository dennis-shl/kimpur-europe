<odoo>

    <record id="sale_order_form_price_unit_base_uom" model="ir.ui.view">
        <field name="name">sale.order.form.price.unit.base.uom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/*[self::list or self::tree]/field[@name='product_uom_id']"
                   position="after">
                <field name="product_base_uom_id"
                       string="Main UoM"
                       optional="show"
                       readonly="1"/>
                <field name="price_unit_base_uom"
                       string="Unit Price (Main UoM)"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_id']"
                   position="after">
                <field name="product_base_uom_id"
                       string="Main UoM"
                       readonly="1"/>
                <field name="price_unit_base_uom"
                       string="Unit Price (Main UoM)"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
